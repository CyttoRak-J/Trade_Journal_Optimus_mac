{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trade Journal",
  "mainBinaryName": "Trade Journal",
  "version": "0.1.0",
  "identifier": "com.tradejournal.desktop",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Trade Journal",
    "longDescription": "Self-hosted trade journal: broker sync, analytics, P&L calendar, and daily journaling. Your data stays on this computer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/**/*"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
